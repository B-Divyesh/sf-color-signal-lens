{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Color Signal Lens",
  "version": "0.1.3",
  "identifier": "in.sociobot.colorsignallens",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Color Signal Lens", "width": 1180, "height": 810, "minWidth": 720, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.sociobot.in" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Utility"
  }
}
